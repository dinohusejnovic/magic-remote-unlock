#!/bin/sh
# Allow older LG Magic Remotes (e.g. MR20) to pair with 2025+ webOS TVs.
#
# Why: lginput2 (the Magic Remote service, com.webos.service.mrcu) keeps a table
# of known remote names with a model year and rejects any remote older than the
# TV's "support start year" ("This remote is not supported by this TV.").
# This script copies the TV's own lginput2 to /tmp, raises the year of the
# older remotes in that copy, bind-mounts the copy over /usr/sbin/lginput2
# and restarts the service. Nothing on the read-only system partition is
# modified; a reboot (or `umount /usr/sbin/lginput2`) restores stock behaviour.
#
# Install to /var/lib/webosbrew/init.d/ (Homebrew Channel runs it at boot).
# Every Bluetooth Magic Remote model older than the TV's newest supported year
# is unlocked; there is nothing to configure.

TARGET="${LGINPUT2_PATH:-/usr/sbin/lginput2}"   # override only for testing
PATCHED=/tmp/lginput2.magic-remote-unlock
LOG=/tmp/magic-remote-unlock.log
SERVICE=lginput2
# Create this file (the app's "Pointer" toggle does) to keep the remote on Bluetooth but turn
# the on-screen pointer and wheel off.
NOPOINTER_FLAG=/var/lib/webosbrew/magic-remote-unlock.nopointer
MODE="$1"   # "--reapply": drop the current patch and apply again (used when the toggle changes)
            # "--check":   dry run, prints what would be patched, changes nothing

log() { echo "$(date '+%F %T') $*" >> "$LOG"; }

patcher() {
    python3 - "$1" "$2" "$3" <<'PY'
import struct, sys
src, dst, no_pointer = sys.argv[1:4]
d = bytearray(open(src, 'rb').read())
assert d[:4] == b'\x7fELF' and d[4] == 1 and d[5] == 1, "expected 32-bit little-endian ELF"
phoff, = struct.unpack_from('<I', d, 0x1c)
phentsize, phnum = struct.unpack_from('<HH', d, 0x2a)
segs = []  # (file_off, vaddr, filesz, flags) of PT_LOAD segments
for i in range(phnum):
    t, off, va, _, fsz, _, fl, _ = struct.unpack_from('<8I', d, phoff + i * phentsize)
    if t == 1:
        segs.append((off, va, fsz, fl))

def o2v(o):
    for off, va, fsz, _ in segs:
        if off <= o < off + fsz:
            return va + o - off

def v2o(v):
    for off, va, fsz, _ in segs:
        if va <= v < va + fsz:
            return off + v - va

u32 = lambda o: struct.unpack_from('<I', d, o)[0]
STRIDE = 0x18  # entry: { kind, type, ?, name_ptr @+0xc, flag, year @+0x14 }

def entry_name(e):
    """Name of the table entry at file offset e, or None if it doesn't look like one."""
    if e < 0 or e + STRIDE > len(d):
        return None
    o = v2o(u32(e + 0xc))
    if o is None or not 2010 <= u32(e + 0x14) <= 2100:
        return None
    end = d.find(b'\0', o)
    name = bytes(d[o:end])
    return name.decode('latin1') if name[:4] in (b'LGE ', b'WEE ') else None

# Anchor on a known remote entry, then walk the whole table around it. MR20 first; the others
# are fallbacks in case a newer firmware drops that entry.
ANCHOR_NAMES = ['LGE MR20', 'LGE MR21', 'LGE MR19', 'LGE MR22', 'LGE MR23', 'LGE MR24', 'LGE MR25GA']
anchors = []
for anchor_name in ANCHOR_NAMES:
    needle = b'\0' + anchor_name.encode() + b'\0'
    hits, i = set(), d.find(needle)
    while i != -1:
        hits.add(o2v(i + 1)); i = d.find(needle, i + 1)
    anchors = []
    for off, va, fsz, fl in segs:
        if fl & 2:  # writable segment (.data) holds the table
            for o in range(off, off + fsz - 3, 4):
                if u32(o) in hits and entry_name(o - 0xc):
                    anchors.append(o - 0xc)
    if len(anchors) == 1:
        break
if len(anchors) != 1:
    sys.exit("SKIP: remote table not found (firmware layout changed?)")
first = anchors[0]
while entry_name(first - STRIDE):
    first -= STRIDE
entries, e = [], first
while entry_name(e):
    entries.append(e); e += STRIDE
new_year = max(u32(e + 0x14) for e in entries)
print("remote table: %d entries, newest year %d (anchor %s)" % (len(entries), new_year, anchor_name))

changed = 0
for e in entries:
    name, year = entry_name(e), u32(e + 0x14)
    # Only Bluetooth Magic Remote style entries (kind 1, type 0). Leave the legacy RF remotes
    # (kind 0), the IR blaster (type 4) and Fire TV remotes alone.
    if year >= new_year or u32(e) != 1 or u32(e + 4) != 0 or 'FTV' in name:
        continue
    struct.pack_into('<I', d, e + 0x14, new_year)
    changed += 1
    print("%-12s %d -> %d" % (name, year, new_year))
if not changed:
    sys.exit("nothing to patch")

# ---- optional: disable the pointer (keep Bluetooth, D-pad and buttons) --------------------
# send_position / send_wheel become "return 0". In send_custom_event, the cursor-on event
# (id 4) is made to take the cursor-off (id 5) path, so menus fall back to D-pad navigation.
u16 = lambda o: struct.unpack_from('<H', d, o)[0]

def dynsym(name):
    shoff, = struct.unpack_from('<I', d, 0x20)
    shentsize, shnum = struct.unpack_from('<HH', d, 0x2e)
    for i in range(shnum):
        sh = shoff + i * shentsize
        _, typ, _, _, off, size, link, _, _, entsize = struct.unpack_from('<10I', d, sh)
        if typ != 11:  # SHT_DYNSYM
            continue
        stroff = struct.unpack_from('<10I', d, shoff + link * shentsize)[4]
        for o in range(off, off + size, entsize or 16):
            n, value, _, info, _, _ = struct.unpack_from('<IIIBBH', d, o)
            e = d.find(b'\0', stroff + n)
            if bytes(d[stroff + n:e]) == name.encode() and value:
                return v2o(value & ~1)

def patch_pointer():
    pos = dynsym('lginput_uinput_send_position')
    wheel = dynsym('lginput_uinput_send_wheel')
    custom = dynsym('lginput_uinput_send_custom_event')
    if None in (pos, wheel, custom):
        return "symbols not found"
    # prologue checks: push {r4,r5,r6,lr} / push.w {r4-r9,lr} / push.w {r4-r11,lr}
    if (u16(pos) != 0xb570 or bytes(d[wheel:wheel + 4]) != b'\x2d\xe9\xf0\x43'
            or bytes(d[custom:custom + 4]) != b'\x2d\xe9\xf0\x4f'):
        return "unexpected function prologues (firmware changed?)"
    # in send_custom_event: "subs r3,r1,#4 ; cmp r3,#1 ; bls <cursor on/off handling>"
    if u16(custom + 0xe) != 0x1f0b or u16(custom + 0x12) != 0x2b01 or u16(custom + 0x16) >> 8 != 0xd9:
        return "unexpected cursor on/off dispatch (firmware changed?)"
    # find "bl isNoCursorRemote ; cmp r0,#0 ; beq <normal send path = custom+0x18>"
    found = []
    for o in range(custom, custom + 0x100, 2):
        h1, h2 = u16(o), u16(o + 2)
        if h1 & 0xf800 == 0xf000 and h2 & 0xd000 == 0xd000 and u16(o + 4) == 0x2800 \
                and u16(o + 6) >> 8 == 0xd0:
            imm = u16(o + 6) & 0xff
            imm -= 0x100 if imm & 0x80 else 0
            if o + 6 + 4 + imm * 2 == custom + 0x18:
                found.append(o)
    if len(found) != 1:
        return "cursor check not found (%d matches)" % len(found)
    m = found[0]
    off_b = (custom + 0x18) - (m + 2 + 4)
    b_instr = 0xe000 | ((off_b >> 1) & 0x7ff)
    d[m:m + 8] = struct.pack('<HHHH', 0x2605, b_instr, 0xbf00, 0xbf00)  # movs r6,#5 ; b ; nop ; nop
    for f in (pos, wheel):
        d[f:f + 4] = b'\x00\x20\x70\x47'                                  # movs r0,#0 ; bx lr
    return None

if no_pointer == '1':
    err = patch_pointer()
    print("pointer: disabled" if err is None else "pointer: SKIPPED, " + err)
open(dst, 'wb').write(d)
PY
}

run() {
    if [ "$MODE" = "--check" ]; then
        PATCHED=/tmp/lginput2.check; LOG=/dev/stdout
        echo "webOS: $(sed -n 's/^PRETTY_NAME=//p' /etc/os-release 2>/dev/null)  arch: $(uname -m)"
        grep -q " $TARGET " /proc/mounts && echo "note: a patch is already mounted, so the table below may show already-patched values"
        patcher "$TARGET" "$PATCHED" 1 2>&1
        echo "(dry run: nothing was changed)"
        rm -f "$PATCHED"; return 0
    fi
    if grep -q " $TARGET " /proc/mounts; then
        [ "$MODE" = "--reapply" ] || { log "already mounted, nothing to do"; return 0; }
        systemctl stop "$SERVICE"; umount "$TARGET" || { log "umount failed"; systemctl start "$SERVICE"; return 1; }
        log "removed previous patch"
    fi
    NOPOINTER=0; [ -e "$NOPOINTER_FLAG" ] && NOPOINTER=1
    command -v python3 >/dev/null 2>&1 || { log "python3 not found, aborting"; return 1; }

    # wait (max 3 min) for the stock binary to be readable
    n=0; while [ ! -r "$TARGET" ] && [ $n -lt 90 ]; do sleep 2; n=$((n+1)); done

    patcher "$TARGET" "$PATCHED" "$NOPOINTER" >> "$LOG" 2>&1
    [ $? -eq 0 ] || { log "patching failed/skipped, leaving stock lginput2 untouched"; return 1; }
    chmod 755 "$PATCHED"
    mount --bind "$PATCHED" "$TARGET" || { log "bind mount failed"; return 1; }
    log "bind-mounted patched lginput2"

    # (re)start so the service runs the patched binary; also starts it if stopped
    systemctl restart "$SERVICE" && log "restarted $SERVICE" || log "restart of $SERVICE failed"
}

if [ "$MODE" = "--check" ]; then run; exit 0; fi
# run detached so the Homebrew startup script is never blocked
( run ) >/dev/null 2>&1 &
exit 0
